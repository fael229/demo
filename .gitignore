# Dependencies
node_modules/
tools/*/node_modules/

# Secrets
.env
.env.*
!.env.example

# Heavy / vendored third-party engines (installed separately)
tools/explainroo/node_modules/

# Inside vendored tools: nested git history (upstream), demo media & docs assets
# are not needed to run the engines - keep only their source.
tools/*/.git/
tools/*/**/*.mp4
tools/*/**/*.webm
tools/*/**/*.mov
tools/*/**/*.gif
tools/*/**/*.webp
tools/*/**/*.jpg
tools/*/**/*.png
tools/*/**/*.pyc
# but keep fonts & scripts the engines load
tools/*/**/*.woff
tools/*/**/*.woff2
tools/*/**/*.wav

# Generated media & artifacts
videos/
audit_screenshots/
qa_*/
test-results/
*.mp4
*.webm
*.mov
*.mp3
# keep small project-owned SFX assets
!assets/**/*.wav

# Tool caches
.argo/
.reanimate/
.cache/
dist/
build/

# OS / editor
.DS_Store
Thumbs.db
*.log
